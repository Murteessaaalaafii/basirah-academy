# ==========================================
# Basirah Academy — Environment Variables
# Project Codename: PRISMATIC INTELLIGENCE
# ==========================================

# Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=3000

# Python FastAPI Intelligence Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PREFIX=/api/v1
DEBUG=True

# Google Gemini API (Optional for cloud LLM; deterministic local Socratic engine runs if unset)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-2.5-flash

# Security & Authentication
JWT_SECRET=basirah_prismatic_intelligence_secret_key_2026
NEXTAUTH_SECRET=basirah_nextauth_secret_token_2026
NEXTAUTH_URL=http://localhost:3000

# Rate Limiting & Token Budgets
MAX_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_DAY_STUDENT=150000

# Firebase Configuration (Optional: local SQLite/Room & in-memory stores active by default)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=basirah-academy
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=basirah-academy.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

