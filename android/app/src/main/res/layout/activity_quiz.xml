<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight_navy"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvQuizHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="KNOWLEDGE CHECK • PASS THRESHOLD 80%"
        android:textColor="@color/crystal_cyan"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvQuestionPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="What is the primary philosophy emphasized in Basirah Academy's approach to AI engineering?"
        android:textColor="@color/pearl_white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp" />

    <RadioGroup
        android:id="@+id/rgOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <RadioButton
            android:id="@+id/rbOption1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_prismatic_card"
            android:padding="12dp"
            android:text="Superficial usage of chat tools without looking under the hood"
            android:textColor="@color/pearl_white"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbOption2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_prismatic_card"
            android:padding="12dp"
            android:text="Rigorous understanding of foundational mechanics, architecture, and practical engineering trade-offs"
            android:textColor="@color/pearl_white"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbOption3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_prismatic_card"
            android:padding="12dp"
            android:text="Memorizing API parameter names without testing them"
            android:textColor="@color/pearl_white"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/deep_space"
        android:padding="14dp"
        android:text="Explanation: Basirah Academy emphasizes deep conceptual intuition and practical engineering over superficial tools."
        android:textColor="@color/soft_slate"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitQuiz"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/crystal_cyan"
        android:text="Submit Assessment"
        android:textColor="@color/midnight_navy"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

</LinearLayout>

