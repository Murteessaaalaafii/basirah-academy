<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvLessonModule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="MODULE 1: FOUNDATIONS &amp; ARCHITECTURE"
            android:textColor="@color/crystal_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1.1 Core Principles &amp; Mathematical Invariants"
            android:textColor="@color/pearl_white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Theory Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/deep_space"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theoretical Foundations"
                    android:textColor="@color/pearl_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLessonBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="In AI engineering, mastery is defined not by how many tools you can invoke, but by how accurately you can diagnose failure modes and reason about computational complexity.\n\nEvery architectural choice balances latency, memory allocation, and statistical accuracy."
                    android:textColor="@color/soft_slate"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Code Block Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/midnight_navy"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="PYTHON 3.12 TELEMETRY CODE"
                    android:textColor="@color/crystal_cyan"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvLessonCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="def compute_attention(q, k, v):\n    d_k = q.shape[-1]\n    scores = np.matmul(q, k.T) / np.sqrt(d_k)\n    return np.matmul(softmax(scores), v)"
                    android:textColor="@color/ice_white"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Row -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenQuiz"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Take Knowledge Assessment"
            android:textColor="@color/luxury_gold"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkComplete"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/crystal_cyan"
            android:text="Complete Lesson &amp; Save Progress"
            android:textColor="@color/midnight_navy"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>
</ScrollView>

